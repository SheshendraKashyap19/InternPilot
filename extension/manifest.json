{
    "manifest_version": 3,
    "name": "InternPilot AI",
    "version": "0.4.0",
    "description": "AI Internship Application Assistant",

    "permissions": [
        "activeTab",
        "tabs",
        "scripting"
    ],

    "host_permissions": [
        "<all_urls>",
        "http://localhost:8080/*",
        "http://127.0.0.1:8000/*"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}